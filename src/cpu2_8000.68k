	OP_R_ON_DP_ADDRESS	move,0x68,d1         | [$b0bf: ldb    $68] [freq=medium, count=34%]
	OP_R_ON_DP_ADDRESS	cmp,0x67,d1          | [$b0c1: cmpb   $67] [freq=medium, count=34%]
	jne	l_b0c6                             	| [$b0c3: bne    $b0c6] [freq=medium, count=34%]
	rts                                    	| [$b0c5: rts] [freq=medium, count=34%]
