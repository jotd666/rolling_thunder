*--------------------------------------------------------------------------
* CPU2 IRQ (once per frame).
* Short path when dp_frame_parity_00 bit0 is set: rebuild the sprite list,
* trigger the sprite latch, re-arm the bank, ack.
* Long path: GAME STATE BARRIER
* LDA dp_state_cpu2_03 / CMPA dp_state_cpu1_02 / BHI skip
* then dispatch the CPU2 state handler through jump_table_81ad.
* $819E writes sprite_latch_1ff2 - that write is what makes the sprite chip
* copy bytes 4-9 to 10-15 of every record at the next VBLANK. Without it
* nothing is ever displayed.
*--------------------------------------------------------------------------
cpu2_irq_8173:
	OP_W_ON_DP_ADDRESS	addq,dp_irqcount2_0f,#1| [$8173: inc    dp_irqcount2_0f] CPU2 IRQ/frame counter [freq=low, count=17%]
	OP_R_ON_DP_ADDRESS	move,dp_frame_parity_00,d0| [$8175: lda    dp_frame_parity_00] frame parity / update-rate flag (bit0 halves the IRQ work) [freq=low, count=17%]
	and.b	#0x01,d0                         	| [$8177: anda   #$01] [freq=low, count=17%]
	jne	l_8195                             	| [$8179: bne    $8195] [freq=low, count=17%]
	OP_R_ON_DP_ADDRESS	move,dp_state_cpu2_03,d0| [$817b: lda    dp_state_cpu2_03] [freq=low, count=17%]
	OP_R_ON_DP_ADDRESS	cmp,dp_state_cpu1_02,d0| [$817d: cmpa   dp_state_cpu1_02] [freq=low, count=17%]
	jhi	l_8189                             	| [$817f: bhi    $8189] [freq=low, count=17%]
* wait until game states are "synchronized" on both cpus
	.ifndef	RELEASE
	move.w	#0x81ad,d2             	| [$8181: ldx    #0x81ad] [freq=low, count=17%]
	.endif
	lea	jump_table_81ad,a2             	| [$8181: ldx    #jump_table_81ad] [freq=low, count=17%]
	OP_R_ON_DP_ADDRESS	move,dp_state_cpu2_03,d0| [$8184: lda    dp_state_cpu2_03] [freq=low, count=17%]
	asl.b	#1,d0                            	| [$8186: asla] [freq=low, count=17%]
	JSR_A_INDEXED	a2,9  | [$8187: jsr    [a,x]] [indirect_jump] [nb_entries=9] [freq=low, count=17%]

l_8189:
	OP_R_ON_DP_ADDRESS	move,dp_bank2_shadow_1a,d0| [$8189: lda    dp_bank2_shadow_1a] shadow of CPU2 ROM bank latch, re-armed every IRQ [freq=low, count=17%]
	jbsr	osd_set_cpu2_bank |  [$818b: sta    bank2_select_d803] [freq=low, count=17%]
	 |  [$818e: sta    watchdog_8000]
	 |  [$8191: sta    irq_ack_8800]
	rts |  [$8194: rti] [freq=low, count=17%]
l_8195:
	jbsr	build_sprite_list_81bb            	| [$8195: jsr    build_sprite_list_81bb]
	jbsr	function_830d                     	| [$8198: jsr    function_830d]
	jbsr	function_848b                     	| [$819b: jsr    function_848b]
	jbsr	osd_latch_sprites |  [$819e: sta    sprite_latch_1ff2] write = tell sprite chip to buffer the list (CPU1 $5FF2)
	OP_R_ON_DP_ADDRESS	move,dp_bank2_shadow_1a,d0| [$81a1: lda    dp_bank2_shadow_1a]
	jbsr	osd_set_cpu2_bank |  [$81a3: sta    bank2_select_d803]
	 |  [$81a6: sta    watchdog_8000]
	 |  [$81a9: sta    irq_ack_8800]
	rts |  [$81ac: rti]


