	.include	"cpu1_options.inc"

	.global infinite_lives_flag
	.global infinite_time_flag

	.global invincible_flag
	.global start_level_flag
	.global skip_intro_flag
	.global up_for_jump_flag
	.global up_previously_pressed_flag
	.global skip_first_loop_flag
	.global vb_ticks_count
	.global break_at_startup_flag
	.global log_ptr
	.global highscore_needs_saving_flag
	.global vbl_sync_counter
	.global vbl_sync_flag
	.global no_sync_flag
	.global cpu1_m6809_direct_page_pointer

	.ifeq	OPT_ALIGNED_MEMORY
	.global	cpu1_ram_buffer
	.global	cpu1_rom_bank
	.global	cpu1_rom_buffer
	.else
	.global cpu1_ram_start_0000
	.global	cpu1_dev_ram_buffer
	.endif
	
	.ifdef   __amiga__
	.else
	* Neogeo: needs different writable section from ROM code
    .bss
	.endif

	.align	4

	.ifeq	OPT_ALIGNED_MEMORY
cpu1_ram_buffer:
	.skip	0x4000		| stops at 0x3000
cpu1_rom_bank:
	.skip	0x2000
cpu1_rom_buffer:
	.skip	0x10000-0x6000
	.else
cpu1_dev_ram_buffer:
	.skip	0x20000
cpu1_ram_start_0000:
	.long	0
	.endif

high_score_beaten:
	.word	0

	

| direct page pointer needs to be reloaded in case of irq
cpu1_m6809_direct_page_pointer:
	.long	0  | 0xA5A5A5A5

skip_intro_flag:
	.byte	0
start_level_flag:
	.byte	0
invincible_flag:
	.byte	0
infinite_lives_flag:
	.byte	0
infinite_time_flag:
	.byte	0
up_previously_pressed_flag:
	.byte	0
up_for_jump_flag:
	.byte	0
skip_first_loop_flag:
	.byte	0
music_off_flag:
	.byte 	0

	.ifndef	OPT_ENABLE_LOGGING
log_ptr:
	.long	0   | 0x100
	.endif
	
highscore_needs_saving_flag:
	.byte	0
vb_ticks_count:
	.byte	0
current_ticks_count:
	.byte	0
vbl_sync_flag:
	.byte	0
vbl_sync_counter:
	.byte	0
no_sync_flag:
	.byte 	0
break_at_startup_flag:
	.byte	0



	