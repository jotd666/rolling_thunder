	.include	"cpu2_options.inc"

	.global cpu2_m6809_direct_page_pointer

	.ifeq	OPT_ALIGNED_MEMORY
	.global	cpu2_ram_buffer
	.global	cpu2_rom_buffer
	.else
	.global cpu2_ram_start_0000
	.global	cpu2_dev_ram_buffer
	.endif
	.global	cpu2_bank_base
	.global	cpu2_current_rom_bank
	.ifdef   __amiga__
	.else
	* Neogeo: needs different writable section from ROM code
    .bss
	.endif

	.align	4

	.ifeq	OPT_ALIGNED_MEMORY
cpu2_ram_buffer:
	.skip	CPU2_ROM_START		| beyond 0x4000: special, beyond 0x6000: unused
cpu2_rom_buffer:
	.skip	0x10000-CPU2_ROM_START
	.else
cpu2_dev_ram_buffer:
	.skip	0x20000
cpu2_ram_start_0000:
	.long	0
	.endif
cpu2_bank_base:
	.long	0
| direct page pointer needs to be reloaded in case of irq
cpu2_m6809_direct_page_pointer:
	.long	0  | 0xA5A5A5A5

cpu2_current_rom_bank:
	.byte 0	


	