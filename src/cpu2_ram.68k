	.include	"cpu2_options.inc"

	.global cpu2_m6809_direct_page_pointer

	.ifeq	OPT_ALIGNED_MEMORY
	.global	cpu2_ram_buffer
	.global	cpu2_rom_bank
	.global	cpu2_rom_buffer
	.else
	.global cpu2_ram_start_0000
	.global	cpu2_dev_ram_buffer
	.endif
	
	.ifdef   __amiga__
	.else
	* Neogeo: needs different writable section from ROM code
    .bss
	.endif

	.align	4

	.ifeq	OPT_ALIGNED_MEMORY
cpu2_ram_buffer:
	.skip	0x4000		| stops at 0x3000
cpu2_rom_bank:
	.skip	0x2000
cpu2_rom_buffer:
	.skip	0x10000-0x6000
	.else
cpu2_dev_ram_buffer:
	.skip	0x20000
cpu2_ram_start_0000:
	.long	0
	.endif


| direct page pointer needs to be reloaded in case of irq
cpu2_m6809_direct_page_pointer:
	.long	0  | 0xA5A5A5A5



	