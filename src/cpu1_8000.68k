* clear non-video RAM (DP)

*--------------------------------------------------------------------------
* Clear the shared direct page ($5600-$56FF), reset both CPUs' state/sub-state/
* semaphore bytes, signal readiness to CPU2 via cpu2_ready_5ff3, enable IRQs and
* fall into the main loop.
*--------------------------------------------------------------------------
normal_start_8190:
	move.w	#0x5600,d2                      	| [$8190: ldx    #$5600] direct page (shared with CPU2 $1600)
	move.b	#0x00,d0                        	| [$8193: ldd    #$0000]
	move.w	#0x0000,d1                      	| [$8193: ldd    #$0000]
l_8196:
	MAKE_D                                 	| [...]
	GET_REG_ADDRESS	0,d2                   	| [$8196: std    ,x++]
	addq.w	#2,d2                           	| [...]
	MOVE_W_FROM_REG	d1,a0                         	| [...]
	cmp.w	#0x5700,d2                       	| [$8198: cmpx   #$5700]
	jcs	l_8196                             	| [$819b: bcs    $8196]
	OP_1_ON_DP_ADDRESS	clr,0xd8             | [$819d: clr    $d8]
	OP_1_ON_DP_ADDRESS	clr,0xd9             | [$819f: clr    $d9]
	OP_1_ON_DP_ADDRESS	clr,0xdb             | [$81a1: clr    $db]
	OP_1_ON_DP_ADDRESS	clr,dp_state_cpu1_02 | [$81a3: clr    dp_state_cpu1_02]
	OP_1_ON_DP_ADDRESS	clr,dp_sub_cpu1_04   | [$81a5: clr    dp_sub_cpu1_04] CPU1 sub-state
	OP_1_ON_DP_ADDRESS	clr,dp_sem_cpu1_06   | [$81a7: clr    dp_sem_cpu1_06]
	jbsr	osd_yield   | sync after semaphore write
	GET_ADDRESS	mcu_game_start_flag_418c   	| [$81a9: clr    mcu_game_start_flag_418c] <-> MCU: game start flag
	clr.b	(a0)                         	| [...]
	move.b	#0x01,d0                        	| [$81ac: lda    #$01]
	GET_ADDRESS	mcu_flag_418d              	| [$81ae: sta    mcu_flag_418d] <-> MCU: game-in-progress flag
	move.b	d0,(a0)                         	| [...]
	GET_ADDRESS	cpu2_ready_5ff3            	| [$81b1: inc    cpu2_ready_5ff3] CPU2 -> CPU1 'POST finished' handshake ($1FF3)
	addq.b	#1,(a0)                         	| [...]
	CLR_I_FLAG                             	| [$81b4: andcc  #$ef] enable interrupts

* jumped-to 1x  from $81BC
*--------------------------------------------------------------------------
* CPU1 main loop: just two calls, forever. All real work happens in the IRQ.
*--------------------------------------------------------------------------
mainloop_81b6:
	 |  [$81b6: jsr    process_event_b40d]
	jbsr	cpu1_run_task_queue_d64a          	| [$81b9: jsr    cpu1_run_task_queue_d64a] [freq=medium, count=37%]
	jbsr	osd_event_loop_cpu2
	jra	mainloop_81b6                      	| [$81bc: bra    mainloop_81b6] [freq=medium, count=38%]


* called 2x  from $856D, $8593
*--------------------------------------------------------------------------
* Per-frame video refresh: recompute the flip-screen flag and active player
* side from the cabinet dips, push the four layers' scroll registers, then read
* the player controls.
*--------------------------------------------------------------------------
irq_update_video_state_81cc:
	OP_R_ON_DP_ADDRESS	move,dp_frame_parity_00,d0| [$81cc: lda    dp_frame_parity_00] frame parity / update-rate flag (bit0 halves the IRQ work) [freq=low, count=20%]
	and.b	#0xfe,d0                         	| [$81ce: anda   #$fe] [freq=low, count=20%]
	GET_ADDRESS	in_level_4247              	| [$81d0: adda   in_level_4247] input level [ 5] dip SWA:6 (freeze) [freq=low, count=20%]
	add.b	(a0),d0                          	| [...]
	OP_W_ON_DP_ADDRESS	move,dp_frame_parity_00,d0| [$81d3: sta    dp_frame_parity_00] [freq=low, count=20%]
	move.b	invincible_flag,d0 |  [$81d5: lda    in_level_4245] input level [ 4] dip SWA:5 (invuln) [freq=low, count=20%]
	OP_W_ON_DP_ADDRESS	move,invulnerable_10,d0| [$81d8: sta    invulnerable_10] [freq=low, count=20%]
	GET_ADDRESS	in_level_4253              	| [$81da: lda    in_level_4253] input level [11] dip SWB:4 (difficulty) [freq=low, count=20%]
	move.b	(a0),d0                         	| [...]
	OP_W_ON_DP_ADDRESS	move,difficulty_3c,d0| [$81dd: sta    difficulty_3c] [freq=low, count=20%]
	jbsr	compute_flip_screen_81e8          	| [$81df: bsr    compute_flip_screen_81e8] [freq=low, count=20%]
	jbsr	compute_active_player_side_8203   	| [$81e1: bsr    compute_active_player_side_8203] [freq=low, count=20%]
	jbsr	update_scroll_layers_821d         	| [$81e3: bsr    update_scroll_layers_821d] [freq=low, count=20%]
	jra	read_player_input_82b8             	| [$81e5: jmp    read_player_input_82b8] [freq=low, count=20%]

* called 1x  from $81DF
*--------------------------------------------------------------------------
* Build flip_screen_5ff6 from dip SWB:6/SWB:7 (cabinet) + dp $01.
* The flip bit physically lives in the sprite control block ($5FF6), not in a
* dedicated register.
*--------------------------------------------------------------------------
compute_flip_screen_81e8:
	move.w	#0x81fb,d4                      	| [$81e8: ldu    #$81fb] ROM [freq=low, count=20%]
	GET_ADDRESS	in_level_4257              	| [$81eb: lda    in_level_4257] input level [13] dip SWB:6 (cabinet) [freq=low, count=20%]
	move.b	(a0),d0                         	| [...]
	add.b	d0,d0                            	| [$81ee: asla] [freq=low, count=20%]
	GET_ADDRESS	in_level_4259              	| [$81ef: ora    in_level_4259] input level [14] dip SWB:7 (cabinet) [freq=low, count=20%]
	or.b	(a0),d0                           	| [...]
	add.b	d0,d0                            	| [$81f2: asla] [freq=low, count=20%]
	GET_DP_ADDRESS	0x01                    	| [$81f3: ora    $01] [freq=low, count=20%]
	or.b	(a0),d0                           	| [...]
	moveq	#0,d6                            	| [...]
	move.b	d0,d6                           	| [...] as byte
	DO_EXTB	d6                             	| [...] with sign extension
	GET_REG_ADDRESS_FROM_REG	d6,d4         	| [$81f5: lda    a,u] [freq=low, count=20%]
	move.b	(a0),d0                         	| [...]
	GET_ADDRESS	flip_screen_5ff6           	| [$81f7: sta    flip_screen_5ff6] screen flip flag (read by video HW via sprite regs) [freq=low, count=20%]
	move.b	d0,(a0)                         	| [...]
	rts                                    	| [$81fa: rts] [freq=low, count=20%]


