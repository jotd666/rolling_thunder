	VIDEO_WORD_DIRTY | [...]
	GET_REG_ADDRESS	0,d5                   	| [$b4ca: dec    ,s] [local]
	subq.b	#1,(a0)                         	| [...]
	jne	l_b4c8                             	| [$b4cc: bne    $b4c8]
	add.w	#0x48,d2                         	| [$b4ce: leax   $48,x]
