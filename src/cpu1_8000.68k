*--------------------------------------------------------------------------
* Spin until the MCU reports alive ($A6 in mcu_ready1_4182).
* PORTING: this never returns unless you emulate the MCU or preset the byte.
*--------------------------------------------------------------------------
wait_mcu_ready1_8547:
	GET_ADDRESS	mcu_ready1_4182            	| [$8547: lda    mcu_ready1_4182] <- MCU: $A6 once the MCU kernel is alive
	move.b	(a0),d0                         	| [...]
	cmp.b	#0xa6,d0                         	| [$854a: cmpa   #$a6]
	jne	wait_mcu_ready1_8547               	| [$854c: bne    wait_mcu_ready1_8547]
	rts                                    	| [$854e: rts]

* called 1x  from $8517, $8554
