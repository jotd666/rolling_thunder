	move.b	(a0),d0                         	| [...]
	cmp.b	#0xa6,d0                         	| [$8552: cmpa   #$a6]
	jne	wait_mcu_ready2_854f               	| [$8554: bne    wait_mcu_ready2_854f]
	rts                                    	| [$8556: rts]

