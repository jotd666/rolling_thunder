set_level_context:
    move.l  d0,-(a7)
    OP_R_ON_DP_ADDRESS    move,starting_area_c5,d0
    jbsr    osd_set_context
    move.l  (a7)+,d0
    rts
set_intermission_context:
    move.l  d0,-(a7)
    moveq   #0,d0
    jbsr    osd_set_context
    move.l  (a7)+,d0
    rts
set_end_context:
    move.l  d0,-(a7)
    OP_R_ON_DP_ADDRESS    move,starting_area_c5,d0
    cmp.b   #0x10,d0    | only loads if end of game (level 10 BCD)
    jne     0f
    moveq   #0,d0
    jbsr    osd_set_context
0:
    move.l  (a7)+,d0
    rts
set_level1_context:
    move.l  d0,-(a7)
    moveq   #1,d0
    jbsr    osd_set_context
    move.l  (a7)+,d0
    rts
