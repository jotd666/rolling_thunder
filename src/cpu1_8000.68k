*--------------------------------------------------------------------------
* CPU1 reset entry.
* Sets stack to $5800 (grows down into $57FF), direct page to $56xx, clears the
* CUS115 expansion latches, then runs the cooperative RAM test described in the
* header: fill a block from ROM, rendezvous with CPU2 on boot_barrier_5ff0,
* verify that CPU2 complemented it, repeat for the three RAM blocks.
* Then ROM checksum, then the MCU handshake at $8107, then falls into
* cpu1_normal_start_8190 if post_errors_5ff1 is still 0.
* PORTING: the barrier relies on both CPUs running concurrently. Skip the whole
* test and jump straight to $8190 with post_errors_5ff1 = 0.
*--------------------------------------------------------------------------
cpu1_boot_8000:
	SET_I_FLAG                             	| [$8000: orcc   #$10]
	move.w	#0x5800,d5                      	| [$8002: lds    #$5800] set stack to almost top RAM
	move.b	#0x56,d0                        	| [$8006: lda    #$56]
	SET_DP_FROM_A                          	| [$8008: tfr    a,dp] direct page: $5600
	jra	normal_start_8190 |  [$800a: clra]
	 |  [$800b: sta    cus115_clear_6e00] bank switch?
	jbsr	osd_select_voice_0 |  [$800e: sta    cus115_63701x_1_6200] bank switch?
	jbsr	osd_select_voice_1 |  [$8011: sta    cus115_63701x_3_6600] bank switch?
	 |  [$8014: sta    cus115_clear_6c00] bank switch?
	GET_ADDRESS	post_errors_5ff1           	| [$8017: clr    post_errors_5ff1] POST error bits: 1=ROM1 2=ROM2 4=RAM0 8=RAM1 invulnerable_10=RAM2 $20=MCU
	clr.b	(a0)                         	| [...]
	GET_ADDRESS	cpu2_ready_5ff3            	| [$801a: clr    cpu2_ready_5ff3] CPU2 -> CPU1 'POST finished' handshake ($1FF3)
	clr.b	(a0)                         	| [...]
	GET_ADDRESS	boot_barrier_5ff0          	| [$801d: clr    boot_barrier_5ff0]
	clr.b	(a0)                         	| [...]
* copy RAM with ROM start several times
	move.w	#watchdog_8000,d2               	| [$8020: ldx    #watchdog_8000]
	clr.w	d3                               	| [$8023: ldy    #$0000] layer 0 tilemap (64x32, 2 bytes/tile)
