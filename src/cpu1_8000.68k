	GET_REG_ADDRESS	0,d5                   	| [$b4c3: sta    ,s] [local]
	move.b	d0,(a0)                         	| [...]
	move.b	#0xff,d0                        	| [$b4c5: ldd    #$ff00]
	move.w	#0xff00,d1                      	| [$b4c5: ldd    #$ff00]
l_b4c8:
