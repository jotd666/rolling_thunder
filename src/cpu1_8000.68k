*--------------------------------------------------------------------------
* Ask the MCU to run its self-test: write $FF to mcu_cmd_4183, wait for
* mcu_ready2_4184 == $A6, clear the command, then dispatch on mcu_result_4185
* (all ten handlers are plain RTS in this revision).
*--------------------------------------------------------------------------
mcu_run_selftest_8512:
	move.b	#0xff,d0                        	| [$8512: lda    #$ff]
	GET_ADDRESS	mcu_cmd_4183               	| [$8514: sta    mcu_cmd_4183] -> MCU: $FF = run self-test / non-zero = test mode
	move.b	d0,(a0)                         	| [...]
	jbsr	wait_mcu_ready2_854f              	| [$8517: bsr    wait_mcu_ready2_854f]
	GET_ADDRESS	mcu_cmd_4183               	| [$8519: clr    mcu_cmd_4183]
	clr.b	(a0)                         	| [...]
	jbsr	dispatch_mcu_selftest_result_851f 	| [$851c: bsr    dispatch_mcu_selftest_result_851f]
	rts                                    	| [$851e: rts]

* called 1x  from $851C
dispatch_mcu_selftest_result_851f:
	GET_ADDRESS	mcu_result_4185            	| [$851f: lda    mcu_result_4185] <- MCU: self-test result, 0 = pass
	move.b	(a0),d0                         	| [...]
* only RTS!!
	add.b	d0,d0                            	| [$8522: asla]
	.ifndef	RELEASE
	move.w	#0x8529,d4             	| [$8523: ldu    #0x8529]
	.endif
	lea	jump_table_8529,a2             	| [$8523: ldu    #jump_table_8529]
	JSR_A_INDEXED	a2,10  | [$8526: jsr    [a,u]] [indirect_jump] [nb_entries=10]

	rts                                    	| [$8528: rts]


