* called 2x  from $8155, $81E3
*--------------------------------------------------------------------------
* Copy the scroll shadow table at $53C0 into the hardware scroll registers
* through the address table at $833A. Layer order and the priority nibble in the
* X-high byte are both taken from that table.
*--------------------------------------------------------------------------
update_scroll_layers_821d:
	move.w	#0x53c0,d2                      	| [$821d: ldx    #$53c0] work RAM (shared with CPU2) [freq=low, count=20%]
	move.w	#0x833a,d4                      	| [$8220: ldu    #$833a] table of scrolling register addresses| ROM [freq=low, count=20%]
	GET_ADDRESS	flip_screen_5ff6           	| [$8223: lda    flip_screen_5ff6] screen flip flag (read by video HW via sprite regs) [freq=low, count=20%]
	move.b	(a0),d0                         	| [...]
	jeq	not_flipped_8270                   	| [$8226: beq    not_flipped_8270] [freq=low, count=20%]
	move.w	#0x8322,d3                      	| [$8228: ldy    #$8322]
l_822c:
