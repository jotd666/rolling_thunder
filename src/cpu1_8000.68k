* jumped-to 1x  from $81E5
*--------------------------------------------------------------------------
* Read one player's controls out of the MCU input block and pack them.
* X = $4276 (player 1) or $426A (player 2) depending on DP $1E
* ,X    button2 edge  (jump, just pressed)
* $5,X  UP level    $7,X  DOWN level    $9,X  RIGHT level    $B,X  LEFT level
* The 4 direction levels form a 4-bit code, translated through the table at
* $834A into a direction, then doubled and incremented if jump was pressed.
* Result in DP $0A. This is the single best place to hook your own controls.
*--------------------------------------------------------------------------
read_player_input_82b8:
	OP_R_ON_DP_ADDRESS	move,dp_state_cpu1_02,d0| [$82b8: lda    dp_state_cpu1_02] [freq=low, count=20%]
	cmp.b	#0x03,d0                         	| [$82ba: cmpa   #$03] [freq=low, count=20%]
	jne	l_82c1                             	| [$82bc: bne    $82c1] [freq=low, count=20%]
	OP_1_ON_DP_ADDRESS	clr,0x0a             | [$82be: clr    $0a]
	rts                                    	| [$82c0: rts]
l_82c1:
	move.w	#in_edge_4276,d2                	| [$82c1: ldx    #in_edge_4276] [freq=low, count=20%]
	OP_R_ON_DP_ADDRESS	move,0x1e,d0         | [$82c4: lda    $1e] [freq=low, count=20%]
	jne	l_82ca                             	| [$82c6: bne    $82ca] [freq=low, count=20%]
	sub.w	#0xc,d2                          	| [$82c8: leax   -$c,x]
l_82ca:
	GET_REG_ADDRESS	0x7,d2                 	| [$82ca: lda    $7,x] [freq=low, count=20%]
	move.b	(a0),d0                         	| [...]
	add.b	d0,d0                            	| [$82cc: asla] [freq=low, count=20%]
	GET_REG_ADDRESS	0x5,d2                 	| [$82cd: adda   $5,x] [freq=low, count=20%]
	add.b	(a0),d0                          	| [...]
	add.b	d0,d0                            	| [$82cf: asla] [freq=low, count=20%]
	GET_REG_ADDRESS	0xb,d2                 	| [$82d0: adda   $b,x] [freq=low, count=20%]
	add.b	(a0),d0                          	| [...]
	add.b	d0,d0                            	| [$82d2: asla] [freq=low, count=20%]
	GET_REG_ADDRESS	0x9,d2                 	| [$82d3: adda   $9,x] [freq=low, count=20%]
	add.b	(a0),d0                          	| [...]
	move.w	#0x834a,d4                      	| [$82d5: ldu    #$834a] ROM [freq=low, count=20%]
	moveq	#0,d6                            	| [...]
	move.b	d0,d6                           	| [...] as byte
	DO_EXTB	d6                             	| [...] with sign extension
	GET_REG_ADDRESS_FROM_REG	d6,d4         	| [$82d8: lda    a,u] [freq=low, count=20%]
	move.b	(a0),d0                         	| [...]
	add.b	d0,d0                            	| [$82da: asla] [freq=low, count=20%]
	GET_REG_ADDRESS	0,d2                   	| [$82db: tst    ,x] 4276 == 1? [freq=low, count=20%]
	tst.b	(a0)                             	| [...]
	jeq	l_82e4                             	| [$82dd: beq    $82e4] [freq=low, count=20%]
