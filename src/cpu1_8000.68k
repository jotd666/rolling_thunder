clear_hud_rect_b4b8:
	move.w	#0x3410,d2                      	| [$b4b8: ldx    #$3410] layer 3 tilemap / HUD
	subq.w	#0x2,d5                         	| [$b4bb: leas   -$2,s] [alloc_locals]
	move.b	#0x0c,d0                        	| [$b4bd: lda    #$0c]
	GET_REG_ADDRESS	0x1,d5                 	| [$b4bf: sta    $1,s] [local]
	move.b	d0,(a0)                         	| [...]
