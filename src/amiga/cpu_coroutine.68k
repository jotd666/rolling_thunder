*=============================================================================
* Two-task cooperative scheduler for the Rolling Thunder 68000 port.
*
* Drop-in replacement for:
*         jsr     cpu1_irq
*         jsr     cpu2_irq
*         rte
* which becomes:
*         jsr     run_frame
*         rte
*
* WHY: CPU1 and CPU2 rendezvous with each other *inside their IRQ handlers*,
* in both directions, several times per frame (see SYNC_POINTS.md).  Running
* one handler to completion and then the other cannot satisfy those, and
* deleting the waits reorders the object updates relative to the sprite-list
* snapshot at CPU2 $896B.
*
* Instead, keep every [semwait] loop exactly as it is and make the spin YIELD
* to the other task.  The semaphores then encode the correct order for you, in
* every game state, including the boot barrier at $5FF0/$1FF0.
*
* No infinite loops: run_frame always returns once both handlers have run.
*
* Disclaimer: The first version file has been generated by Claude A.I.
* then reworked manually by me.
* This is the only file that is generated, all the rest is hand-coded
* by me and mostly by Namco :)
*
*=============================================================================

MAX_YIELDS  = 20000       | deadlock guard| a real frame needs << this
NREGS       = 15          | d0-d7/a0-a6
CTXSIZE     = NREGS*4

|-----------------------------------------------------------------------------
task_sp:            .skip    2*4           | [0] = CPU1 saved SP, [1] = CPU2 saved SP
cpu2_done:          .skip    1*2           | CPU2 handler has returned this frame
cur_task:           .skip    1*2           | 0 = CPU1 running, 1 = CPU2 running
yield_budget:       .skip    1*2

                    .skip    2048        | CPU2's own stack
cpu2_stack_top:

|-----------------------------------------------------------------------------
| run_frame - call once per vblank from your IRQ, in place of the two jsrs.
| Runs cpu1_irq_body on the current (interrupt) stack and cpu2_irq_body on its
| own stack, interleaving them wherever either one blocks on a semaphore.
| Returns when both have completed.  Keep interrupts masked across this call.
|-----------------------------------------------------------------------------
run_frame:
	movem.l d0-d7/a0-a6,-(sp)

	clr.w   cpu2_done
	move.w  #MAX_YIELDS,yield_budget
	clr.w   cur_task

	| Build CPU2 a fresh context: an RTS off this frame lands
	| in cpu2_entry with NREGS longs of (ignored) register fill.
	lea     cpu2_stack_top,a0
	move.l  #cpu2_entry,-(a0)
	sub.l   #CTXSIZE,a0
	move.l  a0,task_sp+4

	jbsr     cpu1_irq_body       | yields into CPU2 at semwaits

	| CPU1 is finished.  If CPU2 has not finished yet, hand it
	| the CPU until it does.  Bounded: cpu2_done ends it.
.drain:
	tst.w   cpu2_done
	jne   .both_done
	jbsr     osd_yield
	jra   .drain
.both_done:
	movem.l (sp)+,d0-d7/a0-a6
	rts

|-----------------------------------------------------------------------------
| cpu2_entry - first thing CPU2's context ever executes.
|-----------------------------------------------------------------------------
cpu2_entry:
	jbsr     cpu2_irq_body
	move.w  #1,cpu2_done
	| fall through: leave for good, do NOT save our context.
	| CPU2's stack is simply abandoned and rebuilt next frame.

|-----------------------------------------------------------------------------
| task_exit - switch to CPU1 permanently.  Never returns to the caller.
|-----------------------------------------------------------------------------
task_exit:
	clr.w   cur_task
	move.l  task_sp+0,sp        | adopt CPU1's stack
	movem.l (sp)+,d0-d7/a0-a6   | unwind CPU1's yield frame
	rts                         | ...back into CPU1's yield call site

|-----------------------------------------------------------------------------
| yield - give the other task a turn.  Call from inside a [semwait] spin.
| Preserves all registers.  If the other task has already finished, returns
| immediately so the caller re-tests its condition (and eventually trips the
| deadlock guard, which means a semaphore nobody posts).
|-----------------------------------------------------------------------------
osd_yield:
	movem.l d0-d7/a0-a6,-(sp)

	subq.w  #1,yield_budget
	jbne   .alive
	jbsr     sync_deadlock       | debug hook / breakpoint
.alive:
	tst.w   cur_task
	bne.s   .from_cpu2

	| --- CPU1 wants to yield to CPU2 ---
	tst.w   cpu2_done
	jne	   .stay               | CPU2 gone: nothing to switch to
	move.l  sp,task_sp+0
	move.w  #1,cur_task
	move.l  task_sp+4,sp
	jra   .stay

	| --- CPU2 wants to yield to CPU1 ---
.from_cpu2:
	move.l  sp,task_sp+4
	clr.w   cur_task
	move.l  task_sp+0,sp
.stay:
	movem.l (sp)+,d0-d7/a0-a6
	rts

*=============================================================================
* A [semwait] becomes this shape.  CPU1 $9D27  "wait until $07 >= 1":
*
*   .w9D27:     cmp.b   #1,sem07
*               bcc.s   .ok
*               bsr     yield
*               bra.s   .w9D27
*   .ok:
*
* CPU2 $8962  "wait until $06 >= 4":
*
*   .w8962:     cmp.b   #4,sem06
*               bcc.s   .ok
*               bsr     yield
*               bra.s   .w8962
*   .ok:
*
* The entry barrier uses bit 7, e.g. CPU1 $9D14  "wait until $07 bit7 set":
*
*   .w9D14:     tst.b   sem07
*               bmi.s   .ok
*               bsr     yield
*               bra.s   .w9D14
*   .ok:
*
* Keep the original watchdog store inside the loop if you emulate a watchdog.
*=============================================================================
*
*=============================================================================
* NOTES
*
* * Keep interrupts masked for the duration of run_frame.  yield swaps SP, and
*   an interrupt landing mid-swap would push onto the wrong stack.
*
* * CPU2 gets its own stack here.  On hardware CPU1's stack is at spriteram
*   $1700-$17FF and CPU2's at $0300-$03FF - genuinely separate - so if your
*   converter emulates the 6809 stacks inside the shared RAM image, keep them
*   separate there too.
*
* * The deadlock guard firing means one side is waiting on a semaphore the
*   other never posts: a mis-converted handler, or a [semwait] you left in
*   whose matching post you optimised away.
*
* * CROSS-FRAME WAITS.  This design assumes each frame's two handlers pair up
*   and both finish within the frame, which holds for the handlers in this
*   game.  If you ever hit a case where CPU1 is still blocked on a semaphore
*   that CPU2 only posts on its *next* IRQ, this scheduler cannot express it -
*   run_frame has to return so you can RTE, and CPU1's context is lost.
*   The faithful fix is to make BOTH tasks persistent across frames: give CPU1
*   its own stack too, wrap each body in
*         task:   bsr <body>
*                 bsr end_of_frame     | yield until the next IRQ pumps us
*                 bra task
*   and have run_frame resume whichever task is current and return only when
*   both have signalled end_of_frame.  That mirrors the hardware exactly (each
*   6809 keeps its PC and stack across interrupts).  It is maybe 20 extra
*   lines| worth doing only if the guard above ever trips for this reason.
*=============================================================================
